{
  "name": "medienreaktor/contentrepository-commands",
  "description": "medienreaktor ContentRepository Commands",
  "type": "neos-package",
  "license": "MIT",
  "require": {
    "php": ">=8.3",
    "ext-json": "*",
    "neos/flow": "^9.0",
    "neos/contentrepositoryregistry": "^9.0"
  },
  "require-dev": {
    "neos/contentgraph-doctrinedbaladapter": "^9.0",
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Medienreaktor\\ContentRepository\\Commands\\": "Classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Medienreaktor\\ContentRepository\\Commands\\Tests\\": "Tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "neos/composer-plugin": true
    }
  },
  "extra": {
    "neos": {
      "package-key": "Medienreaktor.ContentRepository.Commands"
    },
    "branch-alias": {
      "dev-master": "0.3.x-dev"
    }
  },
  "scripts": {
    "test": "./vendor/bin/phpunit",
    "lint:phpstan": "@php vendor/bin/phpstan analyse",
    "lint:phpcs": "./vendor/bin/phpcs --colors",
    "lint:phpcs:fix": "./vendor/bin/phpcbf --colors",
    "lint": [
      "@lint:phpcs",
      "@lint:phpstan"
    ]
  }
}
